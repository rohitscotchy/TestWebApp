[flake8]
# Maximum line length
max-line-length = 120

# Ignore specific errors
ignore = 
    E203,  # whitespace before ':'
    E501,  # line too long (handled by max-line-length)
    W503,  # line break before binary operator
    F401,  # imported but unused (can be verbose)

# Exclude directories
exclude = 
    .git,
    __pycache__,
    .venv,
    venv,
    .pytest_cache,
    .egg-info,
    migrations

# Number of blank lines
max-complexity = 10
